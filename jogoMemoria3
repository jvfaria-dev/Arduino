#define ledVermelho 4
#define ledVerde 19
#define ledAmarelo 18
#define ledAzul 22

#define botaoVermelho 12
#define botaoVerde 32
#define botaoAmarelo 34
#define botaoAzul 26

#define TAMANHO_SEQUENCIA 4
#define INDEFINIDO -1
int sequenciaLuzes[TAMANHO_SEQUENCIA];
enum Estados{
  PRONTO_P_PROX_RODADA,
  RESPOSTA_USUARIO,
  JOGO_FINALIZADO_SUCESSO,
  JOGO_FINALIZADO_FALHA
};
const int meusNumeros[] = {ledVermelho,ledAmarelo,ledVerde,ledAzul};
const int NUM_LEDS_DISPONIVEIS = sizeof(meusNumeros) / sizeof(meusNumeros[0]);

int rodada = 0;
int indiceResposta = 0;
int ledsRespondidos = 0;

void setup() {
  Serial.begin(9600);
  // A linha randomSeed(analogRead(0)); seria removida aqui.
  iniciaPortas();
  iniciaJogo();
  iniciaLeds(); // Continua populando a sequência no setup
}

void iniciaJogo(){
  int jogo = analogRead(14);
  randomSeed(jogo);
  Serial.println("----------Iniciando o jogo----------");
  rodada = 1;
}

void iniciaLeds() {
  for(int i = 0;i<TAMANHO_SEQUENCIA;i++)  {
    sequenciaLuzes[i] = sorteiaCor();
    Serial.print("Cor sorteada para a sequencia: ");
    Serial.println(sequenciaLuzes[i]);
  }
}

void iniciaPortas(){
    pinMode(ledVerde, OUTPUT);
    pinMode(ledAmarelo, OUTPUT);
    pinMode(ledVermelho, OUTPUT);
    pinMode(ledAzul, OUTPUT);

    pinMode(botaoVerde, INPUT_PULLUP);
    pinMode(botaoAmarelo, INPUT_PULLUP);
    pinMode(botaoVermelho, INPUT_PULLUP);
    pinMode(botaoAzul, INPUT_PULLUP);
}

void loop() {
  switch (estadoAtual()) {
    case PRONTO_P_PROX_RODADA:
      Serial.println("Pronto para a próxima rodada?");
      preparaProximaRodada();
      break;
    case RESPOSTA_USUARIO:
      Serial.println("Conferindo resposta do usuário!");
      processaResposta();
      break;
    case JOGO_FINALIZADO_SUCESSO:
      Serial.println("Jogo finalizado com sucesso!");
      break;
    case JOGO_FINALIZADO_FALHA:
      Serial.println("Infelizmente não foi dessa vez. Tente novamente!");
      break;
  }
  /*for(int i = 0; i < TAMANHO_SEQUENCIA; i++)  {
    piscaLed(sequenciaLuzes[i]);
  }
  Serial.print("Sequencia criada. Pressione um botão:");
  int botaoPrecionado = INDEFINIDO;
  while(botaoPrecionado == INDEFINIDO)  {
    botaoPrecionado = confereResposta();
  }
  delay(2000);  */
  delay(500);
}

void preparaProximaRodada() {
  rodada++;
  ledsRespondidos = 0;
  if(rodada < TAMANHO_SEQUENCIA)  {
    tocaLeds();
  }
}

void tocaLeds() {
  for(int i = 0; i < rodada; i++)  {
    piscaLed(sequenciaLuzes[i]);
  }
}

int estadoAtual() {
  if(rodada <= TAMANHO_SEQUENCIA)  {
    if(rodada == ledsRespondidos) {
      return PRONTO_P_PROX_RODADA;
    } else {
      return RESPOSTA_USUARIO;
    }
    }
  else  {
    return JOGO_FINALIZADO_SUCESSO;
  }
}

void processaResposta() {
  int resposta = confereResposta();
  
  if(resposta == INDEFINIDO)  {}

  if(resposta == sequenciaLuzes[ledsRespondidos])  {
    ledsRespondidos++;
  }
  else {
    Serial.println("Resposta Errada!");
  }
  }

int confereResposta() {
  if(digitalRead(botaoVerde) == LOW) {
    return piscaLed(ledVerde);
  }
if(digitalRead(botaoAmarelo) == LOW) {
    return piscaLed(ledAmarelo);
  }
  if(digitalRead(botaoVermelho) == LOW) {
    return piscaLed(ledVermelho);
  }
  if(digitalRead(botaoAzul) == LOW) {
    return piscaLed(ledAzul);
  }
  else {
  return INDEFINIDO;
  }
  }

int piscaLed(int portaLed){
  digitalWrite(portaLed,HIGH);
  delay(1000);
  digitalWrite(portaLed,LOW);
  delay(500);
  return portaLed;
}

int sorteiaCor()  {
  int indiceAleatorio = random(NUM_LEDS_DISPONIVEIS);
  return meusNumeros[indiceAleatorio];
}
